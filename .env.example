# AUTO-TRADE — local Alpaca PAPER template
# Copy manually to .env only when you are ready for the GET-only account preflight.
# .env is gitignored. Never commit real credentials.
#
# IMPORTANT:
# - These variables are for Alpaca PAPER only.
# - The application permanently rejects the LIVE trading host in R6.
# - Leaving R6_EXTERNAL_PAPER_WRITE disabled prevents the final execution CLI gate.

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Keep disabled during installation, local rehearsal, readiness inspection,
# account preflight and offline preparation.
R6_EXTERNAL_PAPER_WRITE=DISABLED
